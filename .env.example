# Optional official OAuth/API mode only; not used by browser collection.
# Set Windows user environment variables. This file is not auto-loaded.
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
# Match token_env in config.json; each prefix supports these suffixes.
DOUYIN_ACCOUNT_1_ACCESS_TOKEN=
DOUYIN_ACCOUNT_1_REFRESH_TOKEN=
DOUYIN_ACCOUNT_1_EXPIRES_AT=
DOUYIN_ACCOUNT_1_SCOPES=video.list,video.data
DOUYIN_ACCOUNT_2_ACCESS_TOKEN=
DOUYIN_ACCOUNT_3_ACCESS_TOKEN=
COLLECT_API_TOKEN=
